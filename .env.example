# bot-team LLM 通道示例（复制为 .env.local 并填值；.env.local 已在 .gitignore）
# 三条通道都已实测 200：opencode-go / deepseek 官方 / 智谱 BigModel

# 默认：OpenCode Go 套餐（30 个模型，key 前缀 oc_sk_）
BOT_LLM_PROVIDER=opencode
BOT_LLM_MODEL=deepseek-v4.1-flash
BOT_LLM_REASONING=high
BOT_LLM_KEY=oc_sk_xxx

# 备选一：DeepSeek 官方按量计费（key 前缀 sk-）
# DEEPSEEK_API_KEY=sk-xxx

# 备选二：智谱 BigModel（GLM-5.3-Flash）
# BIGMODEL_API_KEY=xxx

# 自检：python -B core/llm.py --check
