{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "advisory-report.v1",
  "title": "参谋团收敛产物（并链契约）",
  "description": "参谋团（Octop 专家市场）收敛步必须同时产出 markdown 报告与本 JSON；JSON 由 bot-team/tools/advisory_to_task.py 转成 runs/<task>/report.json 并进入签字/回看链路。",
  "type": "object",
  "required": ["schema", "goal", "finding", "cannot_attribute", "scorecard", "recommendation", "decision_log_entry"],
  "properties": {
    "schema": { "const": "advisory-report.v1" },
    "generated_at": { "type": "string" },
    "task_id": { "type": "string", "description": "可选：由 POST /api/tasks 建好后填入" },
    "crew_id": { "type": "string" },
    "goal": { "type": "string", "minLength": 1 },
    "finding": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["factor", "confidence", "evidence"],
        "properties": {
          "factor": { "type": "string", "minLength": 1 },
          "confidence": { "type": ["string", "number"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "cannot_attribute": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "scorecard": {
      "type": "object",
      "description": "六维：0–5 旧口径或 0–100 百分制都接受，由 core.report_contract 归一",
      "required": ["data_completeness", "timeliness", "significance", "exclusivity", "history", "human_ai_consistency"]
    },
    "recommendation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "roi", "irreversibility"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "roi": {
            "type": "object",
            "required": ["cost", "avoided", "anchor"],
            "properties": {
              "cost": { "type": "string", "minLength": 1 },
              "avoided": { "type": "string", "minLength": 1 },
              "anchor": { "type": "string", "minLength": 1 }
            }
          },
          "irreversibility": { "enum": ["reversible", "irreversible"] }
        }
      }
    },
    "security_gate": {
      "type": "object",
      "description": "含任何 irreversible 建议时必填（fail closed）；status=confirmed 才能 finalize"
    },
    "decision_log_entry": {
      "type": "object",
      "required": ["context", "advice", "expected_result", "verification_plan"],
      "properties": {
        "context": { "type": "string", "minLength": 1 },
        "advice": { "type": "string", "minLength": 1 },
        "expected_result": { "type": "string", "minLength": 1 },
        "verification_plan": { "type": "string", "minLength": 1 }
      }
    },
    "attribution_method": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" }, "description": "证据文件路径（相对 bot-team 或绝对）；会被拷进 runs/<task>/data/ 并算 sha256" },
    "role_coverage": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "string" }
  }
}
