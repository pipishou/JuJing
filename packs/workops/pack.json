{
  "pack_id": "workops",
  "version": "0.1.1",
  "industry": "工作任务管理",
  "thresholds": {
    "overdue_baseline_pct": null,
    "overdue_target_pct": 20.0,
    "cell_null_rate_manual": 0.1,
    "t30_window_days": 30
  },
  "roi_anchors": {
    "reprioritize": 0,
    "defer": 600,
    "drop_scope": 0,
    "add_hand": 1200,
    "escalate": 0,
    "publish_v141_only": 0,
    "hold_price_lines": 0,
    "request_receipt": 0
  },
  "irreversible_actions": [
    "publish_v141_only"
  ],
  "irreversible_keywords": [],
  "six_dims": [
    "data_completeness",
    "timeliness",
    "significance",
    "exclusivity",
    "history",
    "human_ai_consistency"
  ],
  "crew_id": "c-workops-review",
  "scorecard_hard_guardrails": [
    {
      "id": "human_ai_conflict",
      "dim": "human_ai_consistency",
      "op": "==",
      "value": 0,
      "action": "force_manual_review",
      "note": "本人对「哪件事最该砍」的判断与清单统计矛盾"
    },
    {
      "id": "too_many_hypotheses",
      "dim": "exclusivity",
      "op": "<=",
      "value": 10,
      "action": "force_manual_review",
      "note": "同时给出的待办假设过多，等于没有优先级"
    },
    {
      "id": "data_gap",
      "dim": "data_completeness",
      "op": "<=",
      "value": 15,
      "action": "force_manual_review",
      "note": "清单缺负责人/截止日等关键列，无法排序"
    }
  ],
  "thresholds_note": "工作任务管理不设产线口径；逾期率基线由首个快照确立，之后按 t30 窗口滚动。",
  "factors_version": 1,
  "factors": [
    "item_owner",
    "item_due_date",
    "item_status",
    "item_priority",
    "item_source",
    "item_estimate_hours",
    "item_blocker",
    "item_dependency",
    "item_meeting_load",
    "item_scope_change"
  ],
  "metrics": [
    {
      "id": "overdue_rate",
      "name": "逾期率",
      "unit": "%",
      "grain": "weekly",
      "direction": "higher_worse",
      "field": "overdue_rate",
      "control_line_methods": [
        "target",
        "mean_2sigma"
      ]
    },
    {
      "id": "closure_rate",
      "name": "按期闭环率",
      "unit": "%",
      "grain": "weekly",
      "direction": "lower_worse",
      "field": "closure_rate",
      "control_line_methods": [
        "target"
      ]
    },
    {
      "id": "open_items",
      "name": "在办事项数",
      "unit": "条",
      "grain": "weekly",
      "direction": "higher_worse",
      "field": "open_items",
      "control_line_methods": [
        "mean_2sigma"
      ]
    },
    {
      "id": "blocked_items",
      "name": "阻塞事项数",
      "unit": "条",
      "grain": "weekly",
      "direction": "higher_worse",
      "field": "blocked_items",
      "control_line_methods": [
        "mean_2sigma"
      ]
    }
  ],
  "actions": [
    {
      "id": "reprioritize",
      "label": "重排优先级",
      "cost_anchor_key": "reprioritize",
      "reversible": true
    },
    {
      "id": "defer",
      "label": "延期并改承诺日期",
      "cost_anchor_key": "defer",
      "reversible": true
    },
    {
      "id": "drop_scope",
      "label": "砍掉或降级范围",
      "cost_anchor_key": "drop_scope",
      "reversible": true
    },
    {
      "id": "add_hand",
      "label": "加人/外包",
      "cost_anchor_key": "add_hand",
      "reversible": true
    },
    {
      "id": "escalate",
      "label": "升级给上级定夺",
      "cost_anchor_key": "escalate",
      "reversible": true
    },
    {
      "id": "publish_v141_only",
      "label": "只对外发布 v1.4.1 评估件",
      "cost_anchor_key": "publish_v141_only",
      "reversible": false
    },
    {
      "id": "hold_price_lines",
      "label": "按两行价目表放行报价",
      "cost_anchor_key": "hold_price_lines",
      "reversible": true
    },
    {
      "id": "request_receipt",
      "label": "发件后索取客户签收回执",
      "cost_anchor_key": "request_receipt",
      "reversible": true
    }
  ],
  "scene_guardrails": {
    "max_per_month": 6,
    "hard_rules": []
  },
  "scorecard_layers": {
    "data_completeness": {
      "layer": "measured",
      "evidence_required": "factor_coverage"
    },
    "timeliness": {
      "layer": "measured",
      "evidence_required": "data_delay"
    },
    "significance": {
      "layer": "judgment",
      "evidence_required": "rationale"
    },
    "exclusivity": {
      "layer": "judgment",
      "evidence_required": "rationale"
    },
    "history": {
      "layer": "measured",
      "evidence_required": "history_ref"
    },
    "human_ai_consistency": {
      "layer": "sampled",
      "evidence_required": "sample_ref"
    }
  },
  "scorecard_layers_version": "scorecard.layers.v1"
}
